generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  phone       String
  serviceType String
  eventDate   DateTime
  location    String?
  message     String?
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}